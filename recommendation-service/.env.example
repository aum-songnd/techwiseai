# Database PostgreSQL (Nếu chạy trực tiếp trên máy host qua cổng map 5434)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=regulation_db
DB_USER=regulation_user
DB_PASSWORD=regulation_password

# Embedding Service (Sentence-Transformers)
EMBEDDING_API_URL=https://api-production-b778.up.railway.app/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Cấu hình ngưỡng lọc & xếp hạng gợi ý
REC_PRICE_TOLERANCE=0.15
REC_PRICE_HARD_LIMIT=0.35
REC_DEFAULT_LIMIT=8
REC_MAX_LIMIT=12
